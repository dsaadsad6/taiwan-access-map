DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# MapTiler tile endpoint. Sign up for a free API key at https://www.maptiler.com
# and put it in the query string below. See docs/deployment.md for details.
NEXT_PUBLIC_TILE_URL="https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY"
