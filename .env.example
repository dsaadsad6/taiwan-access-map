DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# MapTiler tile endpoint. Sign up for a free API key at https://www.maptiler.com
# and put it in the query string below. See docs/deployment.md for details.
NEXT_PUBLIC_TILE_URL="https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# OAuth provider credentials — register apps at each platform's developer console.
# Callback URL for each is {NEXTAUTH_URL}/api/auth/callback/{google|facebook|line}.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""
