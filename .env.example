DATABASE_URL="file:./dev.db"

# Local-dev-only OpenStreetMap tile endpoint. Before any shared/public deployment,
# switch this to a compliant provider (e.g. MapTiler or Stadia Maps) — see
# docs/deployment.md. OSM's own tile server policy prohibits bulk/production use.
NEXT_PUBLIC_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
